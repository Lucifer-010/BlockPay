# ==============================================================================
# RabaPay Environment Configuration Template (.env.example)
# Copy to .env and customize for your deployment
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,web,testserver,rabapay.xyz,www.rabapay.xyz,api.rabapay.xyz,.rabapay.xyz
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://rabapay.xyz,https://www.rabapay.xyz,https://api.rabapay.xyz,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://rabapay.xyz,https://www.rabapay.xyz,https://api.rabapay.xyz,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
FRONTEND_DOMAIN=rabapay.xyz
API_DOMAIN=api.rabapay.xyz
VITE_API_BASE_URL=https://api.rabapay.xyz/api
VITE_FRONTEND_URL=https://rabapay.xyz
PAGE_SIZE=20
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=7

# Database Configuration
DATABASE_URL=sqlite:///db.sqlite3
POSTGRES_DB=rabapay
POSTGRES_USER=rabapay_user
POSTGRES_PASSWORD=rabapay_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Stellar Testnet & Soroban Smart Contract Configuration
STELLAR_NETWORK=TESTNET
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed RabaPay Soroban Smart Contract on Stellar Testnet
RABAPAY_CONTRACT_ID=CCDT474DVAO4LYDJ7UE4ZPPBN6UBNJHIRPCYAK3TEOHFGC46KNNEOEPK
RABAPAY_WASM_HASH=61acea4a809af90393d36748f95de4c5ff5ed9266ebf88da9067fb12ad9d4442

# Simulated USDC Asset on Stellar Testnet
SIMULATED_USDC_ASSET_CODE=USDC
SIMULATED_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
SIMULATED_USDC_SAC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
STELLAR_ENABLE_LIVE_HORIZON_CHECK=False

